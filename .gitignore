# =====================================================================
# SEGREDOS / CHAVES / TOKENS — NUNCA COMMITAR
# =====================================================================
# Qualquer arquivo .env real (mantemos só os .env.example versionados)
.env
.env.*
!.env.example
!*/.env.example

# appsettings com segredos locais (o appsettings.json/appsettings.Development.json
# de scaffold, sem segredo real, continuam versionados)
appsettings.Local.json
appsettings.*.Local.json
appsettings.Secrets.json
secrets.json
**/secrets/*.json
*.secrets.json

# User Secrets do .NET (caso alguém aponte para pasta local do projeto)
**/UserSecrets.json

