<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Sigis.Application\Sigis.Application.csproj" />
    <ProjectReference Include="..\Sigis.Infrastructure\Sigis.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Pin explícito: Npgsql.EntityFrameworkCore.PostgreSQL (via Sigis.Infrastructure) só exige
         Microsoft.EntityFrameworkCore >= 10.0.4, mas Sigis.Infrastructure é compilado contra 10.0.12
         (via Microsoft.EntityFrameworkCore.Design, que é PrivateAssets="all" e não flui transitivamente).
         Sem este pin, o Sigis.Api resolveria 10.0.4 e conflitaria em tempo de build (MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- Exigido diretamente pelas ferramentas do EF Core (dotnet ef) no projeto de
         inicialização (-s), mesmo já existindo transitivamente em Sigis.Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
